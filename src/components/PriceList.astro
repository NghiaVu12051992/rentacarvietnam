---
import type { PriceRow } from '../lib/detail-pages';
interface Props { rows: PriceRow[] }
const { rows } = Astro.props;
---
<dl class="p-detail-prices">
  {rows.map(row => (
    <div class="p-detail-price-row">
      <dt class="p-detail-price-name">{row.label}</dt>
      <dd class="p-detail-price-values">
        {row.values.map(price => (
          <div class="p-detail-price-value">
            {price.label && <span class="p-detail-price-label">{price.label}</span>}
            <span class:list={['p-detail-price-amount', { 'p-detail-price-amount--accent': price.accent }]}>{price.value}</span>
          </div>
        ))}
      </dd>
    </div>
  ))}
</dl>
