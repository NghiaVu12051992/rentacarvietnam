---
// src/components/BookingWizard.astro
interface Props {
  defaultVehicle?: string;
  defaultDestination?: string;
  id?: string;
}

const {
  defaultVehicle = "",
  defaultDestination = "",
  id = "quick-booking-wizard",
} = Astro.props;
---

<div class="p-card wizard-card" id={id} data-booking-wizard>
  <!-- Wizard Header (Matches reference layout, using exact website brand) -->
  <div class="wizard-header">
      <div class="wizard-top-row">
        <span class="wizard-brand">HANOI CAR & BUS</span>
        <span class="wizard-step-label" id="wizard-step-label">Step 1 of 5</span>
      </div>
      <h2 class="wizard-title">Plan Your Vietnam Trip</h2>
      <p class="wizard-subtitle">Get a personalized itinerary & transport quote.</p>
    </div>

  <!-- Segmented Progress Bar (5 bars) -->
  <div class="wizard-segments" id="wizard-segments" aria-hidden="true">
    <span class="wizard-segment is-active" data-seg="1"></span>
    <span class="wizard-segment" data-seg="2"></span>
    <span class="wizard-segment" data-seg="3"></span>
    <span class="wizard-segment" data-seg="4"></span>
    <span class="wizard-segment" data-seg="5"></span>
  </div>

  <form id="wizard-form" class="wizard-form" novalidate>
    <!-- STEP 1: GROUP SIZE (Exact layout as image) -->
    <div class="wizard-pane is-active" data-step="1">
      <h3 class="pane-title">How many people are traveling?</h3>
      <p class="pane-desc">Select your group size to continue.</p>
      <div class="card-grid">
        <button type="button" class="tap-card" data-group="pax" data-val="1-3 Pax (7-Seater Car)">
          <div class="tap-card-header">
            <svg class="tap-card-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/></svg>
            <svg class="tap-card-check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          </div>
          <span class="tap-card-primary">1–3</span>
          <span class="tap-card-secondary">Passengers</span>
        </button>

        <button type="button" class="tap-card is-selected" data-group="pax" data-val="4-9 Pax (16-Seater Van)">
          <div class="tap-card-header">
            <svg class="tap-card-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/></svg>
            <svg class="tap-card-check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          </div>
          <span class="tap-card-primary">4–9</span>
          <span class="tap-card-secondary">Passengers</span>
        </button>

        <button type="button" class="tap-card" data-group="pax" data-val="10-16 Pax (29-Seater Bus)">
          <div class="tap-card-header">
            <svg class="tap-card-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/></svg>
            <svg class="tap-card-check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          </div>
          <span class="tap-card-primary">10–16</span>
          <span class="tap-card-secondary">Passengers</span>
        </button>

        <button type="button" class="tap-card" data-group="pax" data-val="17-24 Pax (35-Seater Bus)">
          <div class="tap-card-header">
            <svg class="tap-card-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/></svg>
            <svg class="tap-card-check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          </div>
          <span class="tap-card-primary">17–24</span>
          <span class="tap-card-secondary">Passengers</span>
        </button>

        <button type="button" class="tap-card" data-group="pax" data-val="25-45 Pax (45-Seater Coach)">
          <div class="tap-card-header">
            <svg class="tap-card-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/></svg>
            <svg class="tap-card-check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          </div>
          <span class="tap-card-primary">25–45</span>
          <span class="tap-card-secondary">Passengers</span>
        </button>

        <button type="button" class="tap-card" data-group="pax" data-val="45+ Pax (Multiple Coaches)">
          <div class="tap-card-header">
            <svg class="tap-card-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zM17 6a3 3 0 11-6 0 3 3 0 016 0zM12.93 17c.046-.327.07-.66.07-1a6.97 6.97 0 00-1.5-4.33A5 5 0 0119 16v1h-6.07zM6 11a5 5 0 015 5v1H1v-1a5 5 0 015-5z"/></svg>
            <svg class="tap-card-check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          </div>
          <span class="tap-card-primary">45+</span>
          <span class="tap-card-secondary">Passengers</span>
        </button>
      </div>

      <button type="button" class="wizard-continue-btn js-continue">
        <span>Continue</span>
        <span aria-hidden="true">&rarr;</span>
      </button>
    </div>

    <!-- STEP 2: DURATION -->
    <div class="wizard-pane" data-step="2">
      <div class="pane-nav">
        <button type="button" class="back-btn js-back">Back</button>
        <h3 class="pane-title">How many days will you travel?</h3>
      </div>
      <p class="pane-desc">Select your travel duration.</p>
      <div class="card-grid">
        <button type="button" class="tap-card is-selected" data-group="days" data-val="1 Day (City / Airport)">
          <div class="tap-card-header">
            <svg class="tap-card-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
            <svg class="tap-card-check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          </div>
          <span class="tap-card-primary">1 Day</span>
          <span class="tap-card-secondary">Airport or City Tour</span>
        </button>

        <button type="button" class="tap-card" data-group="days" data-val="2 Days (1 Night)">
          <div class="tap-card-header">
            <svg class="tap-card-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
            <svg class="tap-card-check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          </div>
          <span class="tap-card-primary">2 Days</span>
          <span class="tap-card-secondary">1 Night (e.g. Halong)</span>
        </button>

        <button type="button" class="tap-card" data-group="days" data-val="3 Days (2 Nights)">
          <div class="tap-card-header">
            <svg class="tap-card-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
            <svg class="tap-card-check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          </div>
          <span class="tap-card-primary">3 Days</span>
          <span class="tap-card-secondary">Sapa or Ninh Binh</span>
        </button>

        <button type="button" class="tap-card" data-group="days" data-val="4+ Days Multi-Day Tour">
          <div class="tap-card-header">
            <svg class="tap-card-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
            <svg class="tap-card-check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          </div>
          <span class="tap-card-primary">4+ Days</span>
          <span class="tap-card-secondary">Multi-Day Tour / Loop</span>
        </button>
      </div>

      <button type="button" class="wizard-continue-btn js-continue">
        <span>Continue</span>
        <span aria-hidden="true">&rarr;</span>
      </button>
    </div>

    <!-- STEP 3: DESTINATION -->
    <div class="wizard-pane" data-step="3">
      <div class="pane-nav">
        <button type="button" class="back-btn js-back">Back</button>
        <h3 class="pane-title">Where is your destination?</h3>
      </div>
      <p class="pane-desc">Choose your pickup route or destination.</p>
      <div class="card-grid">
        <button type="button" class="tap-card is-selected" data-group="dest" data-val="Noi Bai Airport Transfer">
          <div class="tap-card-header">
            <svg class="tap-card-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
            <svg class="tap-card-check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          </div>
          <span class="tap-card-primary">Noi Bai Airport</span>
          <span class="tap-card-secondary">Flight Pickup / Transfer</span>
        </button>

        <button type="button" class="tap-card" data-group="dest" data-val="Hanoi to Sapa">
          <div class="tap-card-header">
            <svg class="tap-card-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
            <svg class="tap-card-check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          </div>
          <span class="tap-card-primary">Hanoi to Sapa</span>
          <span class="tap-card-secondary">315 km Expressway</span>
        </button>

        <button type="button" class="tap-card" data-group="dest" data-val="Hanoi to Halong Bay">
          <div class="tap-card-header">
            <svg class="tap-card-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
            <svg class="tap-card-check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          </div>
          <span class="tap-card-primary">Hanoi to Halong</span>
          <span class="tap-card-secondary">Cruise Port Transfer</span>
        </button>

        <button type="button" class="tap-card" data-group="dest" data-val="Hanoi to Ninh Binh">
          <div class="tap-card-header">
            <svg class="tap-card-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
            <svg class="tap-card-check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          </div>
          <span class="tap-card-primary">Hanoi to Ninh Binh</span>
          <span class="tap-card-secondary">Trang An & Tam Coc</span>
        </button>

        <button type="button" class="tap-card" data-group="dest" data-val="Ha Giang Loop">
          <div class="tap-card-header">
            <svg class="tap-card-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
            <svg class="tap-card-check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          </div>
          <span class="tap-card-primary">Ha Giang Loop</span>
          <span class="tap-card-secondary">Mountain Scenic Route</span>
        </button>

        <button type="button" class="tap-card" data-group="dest" data-val="Custom Route / Other">
          <div class="tap-card-header">
            <svg class="tap-card-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
            <svg class="tap-card-check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          </div>
          <span class="tap-card-primary">Custom Route</span>
          <span class="tap-card-secondary">Tailor-Made Route</span>
        </button>
      </div>

      <button type="button" class="wizard-continue-btn js-continue">
        <span>Continue</span>
        <span aria-hidden="true">&rarr;</span>
      </button>
    </div>

    <!-- STEP 4: DATE -->
    <div class="wizard-pane" data-step="4">
      <div class="pane-nav">
        <button type="button" class="back-btn js-back">Back</button>
        <h3 class="pane-title">When do you need the vehicle?</h3>
      </div>
      <p class="pane-desc">Select your timing or choose a specific date.</p>

      <div class="card-grid">
        <button type="button" class="tap-card is-selected" data-group="date" data-val="Today">
          <div class="tap-card-header">
            <svg class="tap-card-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/></svg>
            <svg class="tap-card-check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          </div>
          <span class="tap-card-primary">Today</span>
          <span class="tap-card-secondary">Urgent Dispatch</span>
        </button>

        <button type="button" class="tap-card" data-group="date" data-val="Tomorrow">
          <div class="tap-card-header">
            <svg class="tap-card-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/></svg>
            <svg class="tap-card-check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          </div>
          <span class="tap-card-primary">Tomorrow</span>
          <span class="tap-card-secondary">Next Day Schedule</span>
        </button>

        <button type="button" class="tap-card" data-group="date" data-val="This Weekend">
          <div class="tap-card-header">
            <svg class="tap-card-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/></svg>
            <svg class="tap-card-check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          </div>
          <span class="tap-card-primary">This Weekend</span>
          <span class="tap-card-secondary">Saturday or Sunday</span>
        </button>

        <button type="button" class="tap-card" data-group="date" data-val="Flexible Dates">
          <div class="tap-card-header">
            <svg class="tap-card-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/></svg>
            <svg class="tap-card-check" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
          </div>
          <span class="tap-card-primary">Flexible Dates</span>
          <span class="tap-card-secondary">Planning Ahead</span>
        </button>
      </div>

      <!-- Specific Calendar Date Picker -->
      <div class="specific-date-box">
        <label class="p-form-label" for="w-exact-date">Or choose a specific travel date:</label>
        <div class="date-input-group">
          <input
            type="date"
            id="w-exact-date"
            class="p-form-input date-input"
          />
          <button type="button" class="p-btn p-btn-primary" id="w-confirm-date-btn">
            Set Date & Continue
          </button>
        </div>
      </div>

      <button type="button" class="wizard-continue-btn js-continue">
        <span>Continue</span>
        <span aria-hidden="true">&rarr;</span>
      </button>
    </div>

    <!-- STEP 5: CONTACT & DISPATCH -->
    <div class="wizard-pane" data-step="5">
      <div class="pane-nav">
        <button type="button" class="back-btn js-back">Back</button>
        <h3 class="pane-title">Where should we send your quote?</h3>
      </div>
      <p class="pane-desc">Enter your contact to receive our all-inclusive rates.</p>

      <!-- Selection Summary Chip -->
      <div class="summary-chip" id="wizard-summary">
        Loading trip choices...
      </div>

      <!-- Error Banner (Guarantees NO lost lead) -->
      <div class="error-banner" id="wizard-error" style="display: none;"></div>

      <div class="contact-fields">
        <div class="field-item">
          <label class="p-form-label" for="w-contact">WhatsApp / Phone Number *</label>
          <input
            type="text"
            id="w-contact"
            name="contact"
            class="p-form-input"
            required
            placeholder="e.g. +84 900 000 000 or your WhatsApp number"
          />
        </div>

        <div class="field-item">
          <label class="p-form-label" for="w-email">Email Address (Optional)</label>
          <input
            type="email"
            id="w-email"
            name="email"
            class="p-form-input"
            placeholder="e.g. name@example.com"
          />
        </div>

        <div class="field-item">
          <label class="p-form-label" for="w-note">Special Notes (Optional)</label>
          <input
            type="text"
            id="w-note"
            name="note"
            class="p-form-input"
            placeholder="Flight number, child seat, or hotel pickup address"
          />
        </div>

        <button type="submit" class="submit-btn" id="w-submit-btn">
          Get My All-Inclusive Quote &rarr;
        </button>

        <!-- Direct WhatsApp Dispatch Fallback (Shown on error or as 1-click alternative) -->
        <a
          href="#"
          id="wizard-whatsapp-fallback"
          target="_blank"
          rel="noopener noreferrer"
          class="p-btn p-btn-outline whatsapp-fallback-btn"
          style="display: none;"
        >
          Send Request Directly via WhatsApp
        </a>

        <p class="trust-notice">
          Zero upfront booking fee. 100% transparent pricing with driver, tolls and fuel included.
        </p>
      </div>
    </div>

    <!-- SUCCESS PANE (Only reached when confirmed) -->
    <div class="wizard-pane" data-step="success">
      <div class="success-box">
        <span class="p-badge p-badge-primary">CONFIRMED</span>
        <h3 class="success-title">Thank You! Your Request is Received</h3>
        <p class="success-desc">
          Our dispatch team has received your inquiry. We are reviewing vehicle availability and will message your WhatsApp / Email with the confirmed quotation shortly.
        </p>
        <button type="button" class="p-btn p-btn-outline" id="w-reset-btn">
          Submit Another Request
        </button>
      </div>
    </div>
  </form>

  <!-- Instant Messaging Channels (Matching layout in image) -->
  <div class="wizard-instant-channels">
    <span class="instant-channels-label">Prefer to chat with us?</span>
    <div class="instant-channels-links">
      <a href="https://wa.me/84934615595" target="_blank" rel="noopener noreferrer" class="instant-channel-link channel-whatsapp" aria-label="Chat on WhatsApp">
        WhatsApp
      </a>
      <a href="https://m.me/104246472646256" target="_blank" rel="noopener noreferrer" class="instant-channel-link channel-messenger" aria-label="Chat on Messenger">
        Messenger
      </a>
      <a href="https://line.me/R/ti/p/@olf8395f" target="_blank" rel="noopener noreferrer" class="instant-channel-link channel-line" aria-label="Chat on LINE">
        LINE
      </a>
    </div>
    <p class="instant-channels-note">Direct local operator in Vietnam</p>
  </div>
</div>

<script is:inline>
  (() => {
    document.querySelectorAll('[data-booking-wizard]').forEach((wizard) => {
      let currentStep = 1;
      const totalSteps = 5;
      const bookingData = {
        pax: '4-9 Pax (16-Seater Van)',
        days: '1 Day (City / Airport)',
        dest: 'Noi Bai Airport Transfer',
        date: 'Today',
        contact: '',
        email: '',
        note: ''
      };

      const stepLabel = wizard.querySelector('#wizard-step-label');
      const segments = wizard.querySelectorAll('.wizard-segment');
      const panes = wizard.querySelectorAll('.wizard-pane');
      const summaryBox = wizard.querySelector('#wizard-summary');
      const exactDateInput = wizard.querySelector('#w-exact-date');
      const confirmDateBtn = wizard.querySelector('#w-confirm-date-btn');
      const errorBox = wizard.querySelector('#wizard-error');
      const whatsappFallback = wizard.querySelector('#wizard-whatsapp-fallback');

      // Initialize minimum calendar date to today
      if (exactDateInput) {
        const todayIso = new Date().toISOString().split('T')[0];
        exactDateInput.min = todayIso;
      }

      function updateStep(step) {
        currentStep = step;
        panes.forEach(p => {
          if (p.getAttribute('data-step') === String(step)) {
            p.classList.add('is-active');
          } else {
            p.classList.remove('is-active');
          }
        });

        if (typeof step === 'number' && step <= totalSteps) {
          segments.forEach((seg, idx) => {
            if (idx < step) {
              seg.classList.add('is-active');
            } else {
              seg.classList.remove('is-active');
            }
          });
          if (stepLabel) stepLabel.textContent = `Step ${step} of ${totalSteps}`;
        }

        if (step === 5 && summaryBox) {
          summaryBox.textContent = `Trip Summary: ${bookingData.pax || '4-9 Pax'} • ${bookingData.days || '1 Day'} • To: ${bookingData.dest || 'Hanoi'} • Date: ${bookingData.date || 'Flexible'}`;
        }
      }

      // Handle Tap Cards (Selection & Visual State)
      wizard.querySelectorAll('.tap-card').forEach(btn => {
        btn.addEventListener('click', () => {
          const group = btn.getAttribute('data-group');
          const val = btn.getAttribute('data-val');
          if (group && val) {
            bookingData[group] = val;
            const pane = btn.closest('.wizard-pane');
            if (pane) {
              pane.querySelectorAll('.tap-card').forEach(c => c.classList.remove('is-selected'));
              btn.classList.add('is-selected');
            }
          }
        });
      });

      // Handle Continue Buttons
      wizard.querySelectorAll('.js-continue').forEach(btn => {
        btn.addEventListener('click', () => {
          if (currentStep < totalSteps) {
            updateStep(currentStep + 1);
          }
        });
      });

      // Handle Specific Date Selection
      if (confirmDateBtn && exactDateInput) {
        confirmDateBtn.addEventListener('click', () => {
          if (exactDateInput.value) {
            bookingData.date = exactDateInput.value;
            updateStep(5);
          } else {
            exactDateInput.focus();
          }
        });
      }

      // Handle Back Buttons
      wizard.querySelectorAll('.js-back').forEach(btn => {
        btn.addEventListener('click', () => {
          if (typeof currentStep === 'number' && currentStep > 1) {
            updateStep(currentStep - 1);
          }
        });
      });

      // Handle Final Submit with Zero-Lead-Loss Architecture
      const form = wizard.querySelector('#wizard-form');
      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const contactInput = wizard.querySelector('#w-contact');
          if (!contactInput || !contactInput.value.trim()) {
            contactInput?.focus();
            return;
          }

          bookingData.contact = contactInput.value.trim();
          bookingData.email = wizard.querySelector('#w-email')?.value.trim() || '';
          bookingData.note = wizard.querySelector('#w-note')?.value.trim() || '';

          const submitBtn = wizard.querySelector('#w-submit-btn');
          if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting your request...';
          }
          if (errorBox) errorBox.style.display = 'none';
          if (whatsappFallback) whatsappFallback.style.display = 'none';

          try {
            const res = await fetch('/api/quote', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(bookingData)
            });

            const data = await res.json().catch(() => null);

            if (!res.ok || !data?.success) {
              throw new Error(data?.error || `Server responded with status ${res.status}`);
            }

            // Verified success only
            updateStep('success');
          } catch (err) {
            console.error('Quote submission error:', err);
            if (submitBtn) {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Retry Submission';
            }

            // Generate direct WhatsApp fallback link with complete trip details
            const waText = encodeURIComponent(
              `Hello Hanoi Car & Bus Rental! I would like to request an all-inclusive quote:\n` +
              `• Group: ${bookingData.pax || 'N/A'}\n` +
              `• Duration: ${bookingData.days || 'N/A'}\n` +
              `• Destination: ${bookingData.dest || 'N/A'}\n` +
              `• Date: ${bookingData.date || 'N/A'}\n` +
              `• Contact: ${bookingData.contact}\n` +
              (bookingData.note ? `• Special Notes: ${bookingData.note}\n` : '')
            );
            const fallbackUrl = `https://wa.me/84934615595?text=${waText}`;

            if (errorBox) {
              errorBox.textContent = 'Connection notice: Automatic server submission failed. Please click "Retry" or use the direct WhatsApp link below to ensure your booking inquiry is dispatched immediately.';
              errorBox.style.display = 'block';
            }

            if (whatsappFallback) {
              whatsappFallback.href = fallbackUrl;
              whatsappFallback.style.display = 'inline-flex';
            }
          }
        });
      }

      // Reset button
      const resetBtn = wizard.querySelector('#w-reset-btn');
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          form?.reset();
          bookingData.pax = '4-7 Pax (SUV / MPV)';
          bookingData.days = '1 Day (City / Airport)';
          bookingData.dest = 'Noi Bai Airport Transfer';
          bookingData.date = 'Today';
          bookingData.contact = '';
          bookingData.email = '';
          bookingData.note = '';
          updateStep(1);
        });
      }
    });
  })();
</script>
