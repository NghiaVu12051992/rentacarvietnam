---
// src/components/DetailGallery.astro
import ImageSlot from './ImageSlot.astro';
import type { DetailImage } from '../lib/detail-pages';

interface Props {
  image: DetailImage;
  gallery?: DetailImage[];
}

const { image, gallery = [] } = Astro.props;

// Consolidate main image + gallery items into a unified photo album
const allPhotos = [
  image,
  ...(gallery || []),
].filter((photo): photo is DetailImage => Boolean(photo && photo.src));

const initialPhoto = allPhotos[0] || image;
const hasMultiple = allPhotos.length > 1;
---

{allPhotos.length === 0 ? (
  <div class="p-detail-gallery">
    <ImageSlot {...image} eager />
  </div>
) : (
  <section class="p-album-card" aria-label="Vehicle photo album" data-album-container>
    <!-- Main Interactive Photo Display -->
    <div
      class="p-album-viewport"
      data-album-viewport
      role="button"
      tabindex="0"
      aria-label="Click to open full photo view"
    >
      <img
        id="album-main-img"
        src={initialPhoto.src}
        alt={initialPhoto.alt}
        loading="eager"
        decoding="async"
      />
      {hasMultiple && (
        <span class="p-badge p-badge-primary p-album-badge" id="album-counter-badge">
          1 / {allPhotos.length} Photos
        </span>
      )}
      <span class="p-album-open-hint">Click to enlarge</span>
    </div>

    <!-- Active Photo Title & Detailed Description -->
    <div class="p-album-caption">
      <h3 class="p-album-caption-title" id="album-caption-title">
        {initialPhoto.label || 'Exterior View'}
      </h3>
      <p class="p-album-caption-desc" id="album-caption-desc">
        {initialPhoto.alt}
      </p>
    </div>

    <!-- Album Thumbnails Strip -->
    {hasMultiple && (
      <div class="p-album-thumbs" role="tablist" aria-label="Photo gallery selection">
        {allPhotos.map((photo, index) => (
          <button
            type="button"
            class:list={['p-album-thumb', { 'is-active': index === 0 }]}
            data-thumb-index={index}
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-label={`Select photo ${index + 1}: ${photo.label}`}
          >
            <img src={photo.src} alt="" loading="lazy" width="200" height="133" />
          </button>
        ))}
      </div>
    )}

    <!-- Lightbox / Fullscreen Dialog -->
    <dialog class="p-photo-dialog" id="album-photo-dialog" aria-label="Photo lightbox viewer">
      <div class="p-photo-dialog-header">
        <span class="p-badge p-badge-primary" id="lightbox-counter-badge">Photo 1 of {allPhotos.length}</span>
        <button type="button" class="p-quote-close-btn" id="lightbox-close-btn" aria-label="Close photo view">✕</button>
      </div>

      <div class="p-photo-dialog-body">
        <!-- Main Stage with Navigation Arrows -->
        <div class="p-photo-stage">
          {hasMultiple && (
            <button type="button" class="p-photo-nav-btn p-photo-nav-prev" id="lightbox-prev-btn" aria-label="Previous photo">
              ❮
            </button>
          )}

          <img
            id="lightbox-stage-img"
            src={initialPhoto.src}
            alt={initialPhoto.alt}
          />

          {hasMultiple && (
            <button type="button" class="p-photo-nav-btn p-photo-nav-next" id="lightbox-next-btn" aria-label="Next photo">
              ❯
            </button>
          )}
        </div>

        <!-- Photo Info & Sidebar Thumbnails -->
        <aside class="p-photo-sidebar">
          <h4 class="p-photo-sidebar-title" id="lightbox-title">{initialPhoto.label}</h4>
          <p class="p-photo-sidebar-desc" id="lightbox-desc">{initialPhoto.alt}</p>

          {hasMultiple && (
            <div class="p-photo-sidebar-thumbs">
              {allPhotos.map((photo, index) => (
                <button
                  type="button"
                  class:list={['p-photo-sidebar-thumb', { 'is-active': index === 0 }]}
                  data-lightbox-thumb-index={index}
                  aria-label={`Jump to photo ${index + 1}`}
                >
                  <img src={photo.src} alt="" loading="lazy" width="100" height="67" />
                </button>
              ))}
            </div>
          )}
        </aside>
      </div>
    </dialog>
  </section>
)}

<script is:inline define:vars={{ allPhotos }}>
  (() => {
    if (!allPhotos || allPhotos.length === 0) return;

    let currentIndex = 0;
    const total = allPhotos.length;

    // Page Elements
    const mainImg = document.getElementById('album-main-img');
    const counterBadge = document.getElementById('album-counter-badge');
    const captionTitle = document.getElementById('album-caption-title');
    const captionDesc = document.getElementById('album-caption-desc');
    const viewport = document.querySelector('[data-album-viewport]');
    const pageThumbs = document.querySelectorAll('[data-thumb-index]');

    // Dialog Elements
    const dialog = document.getElementById('album-photo-dialog');
    const closeBtn = document.getElementById('lightbox-close-btn');
    const prevBtn = document.getElementById('lightbox-prev-btn');
    const nextBtn = document.getElementById('lightbox-next-btn');
    const lightboxImg = document.getElementById('lightbox-stage-img');
    const lightboxBadge = document.getElementById('lightbox-counter-badge');
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxDesc = document.getElementById('lightbox-desc');
    const dialogThumbs = document.querySelectorAll('[data-lightbox-thumb-index]');

    function updatePhoto(index) {
      if (index < 0) index = total - 1;
      if (index >= total) index = 0;
      currentIndex = index;

      const photo = allPhotos[currentIndex];
      if (!photo) return;

      // Update Page Viewport & Caption
      if (mainImg) {
        mainImg.src = photo.src;
        mainImg.alt = photo.alt;
      }
      if (counterBadge) counterBadge.textContent = `${currentIndex + 1} / ${total} Photos`;
      if (captionTitle) captionTitle.textContent = photo.label || 'Vehicle Photo';
      if (captionDesc) captionDesc.textContent = photo.alt || '';

      pageThumbs.forEach((thumb, i) => {
        if (i === currentIndex) {
          thumb.classList.add('is-active');
          thumb.setAttribute('aria-selected', 'true');
        } else {
          thumb.classList.remove('is-active');
          thumb.setAttribute('aria-selected', 'false');
        }
      });

      // Update Lightbox if open
      if (lightboxImg) {
        lightboxImg.src = photo.src;
        lightboxImg.alt = photo.alt;
      }
      if (lightboxBadge) lightboxBadge.textContent = `Photo ${currentIndex + 1} of ${total}`;
      if (lightboxTitle) lightboxTitle.textContent = photo.label || 'Vehicle Photo';
      if (lightboxDesc) lightboxDesc.textContent = photo.alt || '';

      dialogThumbs.forEach((thumb, i) => {
        if (i === currentIndex) {
          thumb.classList.add('is-active');
        } else {
          thumb.classList.remove('is-active');
        }
      });
    }

    // Page Thumbnails click
    pageThumbs.forEach(thumb => {
      thumb.addEventListener('click', () => {
        const idx = Number(thumb.getAttribute('data-thumb-index'));
        updatePhoto(idx);
      });
    });

    // Open Lightbox on viewport click
    if (viewport && dialog) {
      const openDialog = () => {
        updatePhoto(currentIndex);
        dialog.showModal();
        closeBtn?.focus();
      };

      viewport.addEventListener('click', openDialog);
      viewport.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openDialog();
        }
      });
    }

    // Dialog Close
    closeBtn?.addEventListener('click', () => dialog?.close());

    // Navigation inside Lightbox
    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      updatePhoto(currentIndex - 1);
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      updatePhoto(currentIndex + 1);
    });

    // Lightbox Thumbnails click
    dialogThumbs.forEach(thumb => {
      thumb.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = Number(thumb.getAttribute('data-lightbox-thumb-index'));
        updatePhoto(idx);
      });
    });

    // Keyboard navigation
    dialog?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        updatePhoto(currentIndex - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        updatePhoto(currentIndex + 1);
      }
    });
  })();
</script>
