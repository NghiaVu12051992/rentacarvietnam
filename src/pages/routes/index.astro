---
// src/pages/routes/index.astro
import ImageSlot from '../../components/ImageSlot.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingWizard from '../../components/BookingWizard.astro';
import routesData from '../../data/routes.json';

const pageTitle = "Popular Intercity Transfer Routes | Hanoi Car & Bus Rental";
const pageDesc = "Direct private car and bus transfers from Hanoi to Sapa, Halong Bay, Ninh Binh, Ha Giang, and Noi Bai Airport. Tolls, fuel, and driver included.";
---

<BaseLayout hasBookingWizard title={pageTitle} description={pageDesc}>
  <div class="p-container">
    <header class="page-header">
      <span class="p-badge p-badge-primary">POPULAR ROUTES</span>
      <h1 class="page-title">Northern Vietnam Private Transfers</h1>
      <p class="page-subtitle">
        Fast, direct expressway travel with door-to-door hotel pickup and professional drivers. No crowded buses, no train transfers.
      </p>
    </header>

    <div class="routes-list">
      {routesData.map((r) => (
        <article class="p-card route-entry">
          <div class="entry-main">
            <ImageSlot src={r.image} alt={r.imageAlt} label={r.name} isAi={r.isAi} />
            <h2 class="entry-title">{r.name}</h2>
            <div class="metric-tags">
              <span class="p-badge p-badge-primary">{r.distance}</span>
              <span class="p-badge p-badge-outline">{r.duration}</span>
              <span class="highway-tag">{r.highway}</span>
            </div>
            <p class="entry-desc">{r.description}</p>

            <ul class="highlights-list">
              {r.highlights.map((h) => (
                <li>
                  <span class="bullet">✓</span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
          </div>

          <div class="entry-pricing">
            <div class="pricing-header">
              <h3 class="pricing-title">Starting Rates</h3>
              <span class="pricing-badge">All-Inclusive</span>
            </div>
            <ul class="rate-list">
              {r.pricing.map((p) => (
                <li class="rate-row">
                  <span class="rate-vehicle">{p.vehicle}</span>
                  <span class="rate-quote">
                    <strong class="rate-price">{p.oneWay}</strong>
                    {p.roundTrip !== "N/A" && (
                      <span class="rate-roundtrip">/ {p.roundTrip}</span>
                    )}
                  </span>
                </li>
              ))}
            </ul>
            <a href={`/routes/${r.slug}/`} class="p-btn p-btn-primary full-width-btn">
              View Itinerary & Book
            </a>
          </div>
        </article>
      ))}
    </div>

    <!-- Booking Form Section -->
    <section class="inquiry-section">
      <div class="inquiry-header">
        <span class="p-badge p-badge-primary">CUSTOM ROUTES</span>
        <h2 class="inquiry-title">Need a Custom Route or Multi-City Tour?</h2>
        <p class="inquiry-subtitle">Tell us your schedule and our dispatch team will tailor an exact itinerary for your group.</p>
      </div>
      <BookingWizard />
    </section>
  </div>
</BaseLayout>

<style>
  .page-header {
    text-align: center;
    max-width: 760px;
    margin: var(--space-xl) auto var(--space-xl) auto;
  }
  .page-title {
    font-size: var(--font-size-3xl);
    color: var(--color-navy);
    margin-top: var(--space-2xs);
    margin-bottom: var(--space-xs);
    font-weight: var(--font-weight-bold);
  }
  .page-subtitle {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    line-height: var(--line-height-comfortable);
  }

  .routes-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
  .route-entry {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-lg);
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: var(--space-xl);
    align-items: start;
  }
  .entry-title {
    font-size: var(--font-size-xl);
    color: var(--color-navy);
    margin-bottom: var(--space-xs);
    font-weight: var(--font-weight-bold);
  }
  .metric-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    align-items: center;
    margin-bottom: var(--space-sm);
  }
  .highway-tag {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }
  .entry-desc {
    font-size: var(--font-size-sm);
    color: var(--color-navy);
    line-height: var(--line-height-comfortable);
    margin-bottom: var(--space-sm);
  }
  .highlights-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }
  .highlights-list li {
    display: flex;
    gap: var(--space-xs);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }
  .bullet {
    color: var(--color-success);
    font-weight: var(--font-weight-bold);
  }

  .entry-pricing {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xs);
    padding: var(--space-sm) var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }
  @media (max-width: 900px) {
    .entry-pricing {
      background: transparent;
      border: none;
      border-top: 1px solid var(--color-border);
      border-radius: 0;
      padding: var(--space-sm) 0 0 0;
      gap: var(--space-xs);
    }
  }
  .pricing-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xs);
    padding-bottom: var(--space-3xs);
    border-bottom: 1px solid var(--color-border);
  }
  .pricing-title {
    font-size: var(--font-size-sm);
    color: var(--color-navy);
    font-weight: var(--font-weight-bold);
    margin: 0;
  }
  .pricing-badge {
    font-size: var(--font-size-2xs);
    color: var(--color-primary-dark);
    font-weight: var(--font-weight-semibold);
    background: var(--color-primary-light);
    padding: 2px 6px;
    border-radius: var(--radius-full);
  }
  .rate-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .rate-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-xs);
    padding: var(--space-2xs) 0;
    border-bottom: 1px solid var(--color-border);
    font-size: var(--font-size-xs);
  }
  .rate-row:last-child {
    border-bottom: none;
  }
  .rate-vehicle {
    color: var(--color-navy);
    font-weight: var(--font-weight-medium);
    flex: 1;
    min-width: 0;
  }
  .rate-quote {
    display: flex;
    align-items: baseline;
    gap: var(--space-3xs);
    flex-shrink: 0;
    white-space: nowrap;
    text-align: right;
  }
  .rate-price {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-price);
  }
  .rate-roundtrip {
    font-size: var(--font-size-2xs);
    color: var(--color-text-muted);
  }
  .full-width-btn {
    width: 100%;
    margin-top: var(--space-2xs);
  }

  .inquiry-section {
    margin-top: var(--space-xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--color-border);
  }
  .inquiry-header {
    text-align: center;
    max-width: 680px;
    margin: 0 auto var(--space-lg) auto;
  }
  .inquiry-title {
    font-size: var(--font-size-2xl);
    color: var(--color-navy);
    margin-top: var(--space-3xs);
    margin-bottom: var(--space-xs);
  }
  .inquiry-subtitle {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }

  @media (max-width: 860px) {
    .route-entry {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }
  }
</style>
